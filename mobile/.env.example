# Same Supabase project as the web app — copy values from ../.env.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Base URL for the thin /api/mobile/* routes in the Next.js app (registration,
# Paystack checkout init, KYC). Use http://localhost:3000 (or your machine's
# LAN IP, e.g. http://192.168.1.10:3000, when testing on a physical device)
# while the Next.js dev server is running; use the production domain otherwise.
API_BASE_URL=https://kolejswap.com
