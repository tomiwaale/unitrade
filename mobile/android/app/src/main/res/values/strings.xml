<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Must match the channel created in lib/core/push/push_service.dart.
         FCM uses this for notifications that arrive while the app is
         backgrounded; without it those land on a system fallback channel at
         default importance instead of the high-importance channel the app
         defines, so foreground and background banners behave differently. -->
    <string name="default_notification_channel_id">default</string>
</resources>
